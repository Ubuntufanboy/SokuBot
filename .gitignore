# virtualenv
.venv/
venv/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# data + artefacts -- never commit these.
# Anchored with a leading slash: a bare `data/` also matches `sokubot/data/`,
# which is source code.
/data/
/datasets/
/checkpoints/
/runs/
*.npz
*.mp4
*.rep
*.pt
*.ckpt

# scratch
*.log
.DS_Store

# Annotation/labelling working sets. The labels themselves are small and worth
# keeping; the harvested crops and rendered sheets are regenerable from the
# corpus and run to tens of megabytes.
banners/
banners_label/crops/
banners_label/sheet_*.png
hud_annot/crops/
hud_annot/sheet_*.png
